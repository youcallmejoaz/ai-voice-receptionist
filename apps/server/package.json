{
  "name": "@avr/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && cp src/db/schema.sql dist/db/schema.sql",
    "start": "node dist/index.js",
    "seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.2.0",
    "better-sqlite3": "12.11.1",
    "cookie-parser": "1.4.7",
    "csv-parse": "7.0.3",
    "express": "5.1.0",
    "next": "15.5.28",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/node": "22.18.0",
    "@types/supertest": "6.0.3",
    "@vapi-ai/web": "3.0.1",
    "supertest": "7.1.4",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
