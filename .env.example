# ---- Server ----
PORT=3000
NODE_ENV=development
# Public base URL Vapi uses to reach the tool webhook (your Render URL in production)
PUBLIC_BASE_URL=https://your-app.onrender.com
# SQLite file and private recordings directory (put both on the Render persistent disk)
DATABASE_PATH=./data/receptionist.db
RECORDINGS_DIR=./data/recordings

# ---- Dashboard auth ----
# Password for the admin dashboard login; SESSION_SECRET signs the session cookie
ADMIN_PASSWORD=change-me
SESSION_SECRET=generate-a-long-random-string

# ---- Vapi ----
# Private key: server only (assistant sync). Public key: browser web calls.
VAPI_PRIVATE_KEY=
VAPI_PUBLIC_KEY=
# Shared secret Vapi sends back on every webhook (x-vapi-secret header)
VAPI_WEBHOOK_SECRET=generate-a-long-random-string
# Optional: set to enable real phone calls (outbound PSTN + live transfer)
VAPI_PHONE_NUMBER_ID=

# ---- Summaries (Claude) ----
ANTHROPIC_API_KEY=
SUMMARY_MODEL=claude-haiku-5-5

# ---- Integrations ----
# calendar adapter: mock | google
CALENDAR_PROVIDER=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional CRM webhook: every new lead is POSTed here as JSON (HubSpot/Zapier/Make etc.)
CRM_WEBHOOK_URL=
